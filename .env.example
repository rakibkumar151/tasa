# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Dashboard API Key (Required in Production)
API_KEY=your_secure_api_key_here

# Turso Cloud SQLite Database (Recommended for Render)
TURSO_DATABASE_URL=libsql://your-db-name.aws-region.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# Persistent Local SQLite Fallback (Optional if using Render Persistent Disk)
# DB_PATH=/var/data/fingerprints.db
# KEY_DIR=/var/data/keys

# Key Management (Optional - auto-generated if omitted)
# KEY_ID=prod-key-1
# PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
